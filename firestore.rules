rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Batch 41 Group Chat Messages
    // Authoritative real-time collection for group messages
    // =========================================================================
    match /group_chat_messages/{messageId} {
      // 1. Everyone can read chat messages (App-level gate in App.tsx secures access)
      allow read: if true;

      // 2. Allow message creation for both Google OAuth and verified Mail ID sessions
      allow create: if true;

      // 3. Allow update for message reactions, poll voting, pinning, and seen receipts
      allow update: if true;

      // 4. Delete messages
      allow delete: if true;
    }

    // =========================================================================
    // Students / Batch Members Profiles
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // =========================================================================
    // Batch Wall Updates / Bulletin Board
    // =========================================================================
    match /batch_updates/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Instagram / Photo Feed Posts
    // =========================================================================
    match /instagram_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Shared Deleted Posts Registry (Syncs permanent deletion across all clients)
    // =========================================================================
    match /deleted_posts/{postId} {
      allow read, write: if true;
    }

    // =========================================================================
    // Discord-style Live Voice Room
    // =========================================================================
    match /voice_room_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    match /voice_room_events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
