rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Batch 41 Group Chat Messages
    // Authoritative real-time collection for group messages
    // =========================================================================
    match /group_chat_messages/{messageId} {
      // 1. Everyone can read chat messages
      allow read: if true;

      // 2. Only authenticated users can send messages, and senderId/senderEmail must match their logged-in identity
      allow create: if request.auth != null &&
                    request.resource.data.senderId == request.auth.uid &&
                    (
                      request.auth.token.email == null ||
                      request.resource.data.senderEmail == request.auth.token.email
                    );

      // 3. Allow update for message reactions, poll voting, pinning, and seen receipts
      allow update: if request.auth != null;

      // 4. Only the original sender can delete their own message
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // =========================================================================
    // Students / Batch Members Profiles
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == studentId;
    }

    // =========================================================================
    // Batch Wall Updates / Bulletin Board
    // =========================================================================
    match /batch_updates/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Instagram / Photo Feed Posts
    // =========================================================================
    match /instagram_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Shared Deleted Posts Registry (Syncs permanent deletion across all clients)
    // =========================================================================
    match /deleted_posts/{postId} {
      allow read, write: if true;
    }

    // =========================================================================
    // Discord-style Live Voice Room
    // =========================================================================
    match /voice_room_members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /voice_room_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
