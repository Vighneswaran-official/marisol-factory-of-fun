rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Batch 41 Group Chat Messages
    // Authoritative real-time collection for group messages
    // =========================================================================
    match /group_chat_messages/{messageId} {
      // Allowed for all batch members so initial app load never throws permission denied
      allow read, create, update, delete: if true;
    }

    // =========================================================================
    // Students / Batch Members Profiles
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == studentId;
    }

    // =========================================================================
    // Batch Wall Updates / Bulletin Board
    // =========================================================================
    match /batch_updates/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Instagram / Photo Feed Posts
    // =========================================================================
    match /instagram_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // Shared Deleted Posts Registry (Syncs permanent deletion across all clients)
    // =========================================================================
    match /deleted_posts/{postId} {
      allow read, write: if true;
    }

    // =========================================================================
    // Discord-style Live Voice Room
    // =========================================================================
    match /voice_room_members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /voice_room_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
